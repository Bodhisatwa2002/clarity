# Clarity — template for .env (copy to .env and fill in). .env is git-ignored.
# Used by local tools and scripts only; the app reads config/<env>.json.

APP_ENV=staging

SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co

# Public keys (safe in the app).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_ANON_KEY=

# SECRET — server-side tools only. Never in the app or in git.
SUPABASE_SERVICE_ROLE_KEY=

# Needed by `supabase link` / `supabase db push`.
SUPABASE_DB_PASSWORD=

# Twilio (phone OTP). Hosted: Supabase dashboard. Local: supabase/config.toml.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
